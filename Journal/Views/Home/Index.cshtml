@model Journal.ApiModels.HomePageModel
@{
    ViewData["Title"] = "Home Page";
}

<section class="hero container-fluid px-0">
    <div class="hero-media">
        <img src="https://journalstorageaccount.blob.core.windows.net/journals/c913a98b2f4031a43f218b1eebe06661.gif" alt="" class="hero-gif">
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content container">
        <h1>FIND YOUR JOURNAL</h1>
        <p>Discover timeless craftsmanship and exceptional quality with our curated collection of handmade journals.</p>
    </div>
</section>

@if (Model.Featured != null)
{
    var f = Model.Featured;
    <section class="featured container">
        <h2 class="text-center">Featured Journal</h2>
        <a class="featured-card-link" asp-controller="Journal" asp-action="Details" asp-route-id="@f.Id">
            <div class="featured-card row g-4 align-items-stretch">
                <img src="@f.ImageUrl" alt="@f.Title">
                <div class="featured-info">
                    <span class="badge">FEATURED</span>
                    <h3>@f.Title</h3>
                    <p class="developer">@f.Code</p>
                    <p class="location">@f.TypeSubtitle</p>
                    <hr class="divider">
                    <p class="property-type">@f.TypeName</p>
                    <p class="price">₱@f.Price.ToString("N0")</p>
                    <p>@f.Description</p>
                </div>
            </div>
        </a>
    </section>
}

@foreach (var group in Model.Sections)
{
    <section class="properties">
        <h2>@group.Type.Name</h2>
        <div class="property-grid-3">
            @foreach (var item in group.Items)
            {
                <a class="property-card" asp-controller="Journal" asp-action="Details" asp-route-id="@item.Id">
                    <div class="thumb-wrap">
                        <img src="@item.ImageUrl" alt="@item.Title">
                        @if (item.IsFeatured)
                        {
                            <span class="featured-badge">FEATURED</span>
                        }
                    </div>
                    <div class="card-body">
                        <p class="price">₱@item.Price.ToString("N0")</p>
                        <p class="title">@item.Title</p>
                        <p class="location">@group.Type.Name</p>
                        <p class="sqm">@group.Type.Subtitle</p>
                        <p class="by">@item.Code</p>
                    </div>
                </a>
            }
        </div>
    </section>
}